{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hero_id": {"type": "integer"},
    "path_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "narrative_basis_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 700,
      "pattern": "[.!?]$"
    }
  },
  "required": [
    "hero_id",
    "path_id",
    "snapshot_id",
    "policy_id",
    "context_sha256",
    "narrative_basis_sha256",
    "build_description"
  ],
  "additionalProperties": false
}
