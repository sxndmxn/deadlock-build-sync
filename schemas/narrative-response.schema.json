{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hero_id": {
      "type": "integer"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "narrative_basis_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tactical_profile": {
      "type": "object",
      "properties": {
        "primary_role": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "fight_role": {
          "type": "string",
          "minLength": 20,
          "maxLength": 350
        },
        "economy_plan": {
          "type": "string",
          "minLength": 20,
          "maxLength": 350
        },
        "power_spikes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "quarter": {
                "type": "string",
                "enum": [
                  "I",
                  "II",
                  "III",
                  "IV"
                ]
              },
              "trigger": {
                "type": "string",
                "minLength": 20,
                "maxLength": 220
              },
              "tactical_unlock": {
                "type": "string",
                "minLength": 30,
                "maxLength": 400
              }
            },
            "required": [
              "quarter",
              "trigger",
              "tactical_unlock"
            ],
            "additionalProperties": false
          }
        },
        "duration_plan": {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "enum": [
                "EARLY_CLOSER",
                "MIDGAME_PEAK",
                "LATE_SCALING",
                "STABLE",
                "MIXED"
              ]
            },
            "strongest_phase": {
              "type": "string",
              "enum": [
                "EARLY (<30m)",
                "MID (30–45m)",
                "LATE (45m+)"
              ]
            },
            "weakest_phase": {
              "type": "string",
              "enum": [
                "EARLY (<30m)",
                "MID (30–45m)",
                "LATE (45m+)"
              ]
            },
            "macro_plan": {
              "type": "string",
              "minLength": 30,
              "maxLength": 350
            },
            "late_build_response": {
              "type": "string",
              "enum": [
                "REINFORCE",
                "COMPENSATE",
                "MIXED"
              ]
            },
            "response_reason": {
              "type": "string",
              "minLength": 40,
              "maxLength": 400
            }
          },
          "required": [
            "shape",
            "strongest_phase",
            "weakest_phase",
            "macro_plan",
            "late_build_response",
            "response_reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "primary_role",
        "fight_role",
        "economy_plan",
        "power_spikes",
        "duration_plan"
      ],
      "additionalProperties": false
    },
    "build_summary": {
      "type": "string",
      "minLength": 80,
      "maxLength": 700
    },
    "quarters": {
      "type": "object",
      "properties": {
        "I": {
          "type": "string",
          "minLength": 60,
          "maxLength": 600
        },
        "II": {
          "type": "string",
          "minLength": 60,
          "maxLength": 600
        },
        "III": {
          "type": "string",
          "minLength": 60,
          "maxLength": 600
        },
        "IV": {
          "type": "string",
          "minLength": 60,
          "maxLength": 600
        }
      },
      "required": [
        "I",
        "II",
        "III",
        "IV"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "hero_id",
    "context_sha256",
    "narrative_basis_sha256",
    "tactical_profile",
    "build_summary",
    "quarters"
  ],
  "additionalProperties": false
}
