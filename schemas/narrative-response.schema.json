{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hero_id": {"type": "integer"},
    "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "narrative_basis_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tactical_profile": {
      "type": "object",
      "properties": {
        "primary_role": {"type": "string", "minLength": 3, "maxLength": 100},
        "fight_role": {"type": "string", "minLength": 20, "maxLength": 350},
        "economy_plan": {"type": "string", "minLength": 20, "maxLength": 350},
        "ending_duration_interpretation": {
          "type": "object",
          "properties": {
            "estimand": {
              "type": "string",
              "const": "ending_duration_profile"
            },
            "strongest_phase": {
              "type": "string",
              "enum": [
                "EARLY (<30m)",
                "MID (30–45m)",
                "LATE (45m+)",
                "UNAVAILABLE"
              ]
            },
            "weakest_phase": {
              "type": "string",
              "enum": [
                "EARLY (<30m)",
                "MID (30–45m)",
                "LATE (45m+)",
                "UNAVAILABLE"
              ]
            },
            "plan": {"type": "string", "minLength": 30, "maxLength": 350}
          },
          "required": ["estimand", "strongest_phase", "weakest_phase", "plan"],
          "additionalProperties": false
        }
      },
      "required": [
        "primary_role",
        "fight_role",
        "economy_plan",
        "ending_duration_interpretation"
      ],
      "additionalProperties": false
    },
    "build_summary": {"type": "string", "minLength": 80, "maxLength": 700},
    "action_explanations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1},
          "instruction": {"type": "string", "minLength": 20, "maxLength": 400}
        },
        "required": ["node_id", "evidence_ref", "instruction"],
        "additionalProperties": false
      }
    },
    "category_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "category": {"type": "string", "minLength": 1, "maxLength": 100},
          "summary": {"type": "string", "minLength": 30, "maxLength": 600}
        },
        "required": ["category", "summary"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "hero_id",
    "snapshot_id",
    "policy_id",
    "context_sha256",
    "narrative_basis_sha256",
    "tactical_profile",
    "build_summary",
    "action_explanations",
    "category_summaries"
  ],
  "additionalProperties": false
}
