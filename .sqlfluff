[sqlfluff]
dialect = duckdb
templater = placeholder
rules = all
exclude_rules =
warnings =
ignore =
disable_noqa = True
# Use standard SQLFluff exceptions for unsupported syntax and dynamic exports.
disable_noqa_except = PRS,AM04
warn_unused_ignores = True
ignore_templated_areas = False
fix_even_unparsable = False
large_file_skip_byte_limit = 0
large_file_skip_char_limit = 0
large_file_skip_fail = True
max_line_length = 88
encoding = utf-8
processes = 1

[sqlfluff:rules:references.quoting]
prefer_quoted_keywords = True

# These exact column names come from the remote DuckLake schema.
[sqlfluff:rules:references.special_chars]
ignore_words = stats.time_stamp_s,stats.net_worth,items.item_id,items.game_time_s,items.sold_time_s,items.imbued_ability_id

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = explicit

[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = ansi

[sqlfluff:rules:convention.terminator]
require_final_semicolon = True

[sqlfluff:rules:convention.casting_style]
preferred_type_casting_style = shorthand

# These values only let the linter parse bound parameters. Queries keep their bindings.
[sqlfluff:templater:placeholder]
param_regex = \$(?P<param_name>[A-Za-z_][A-Za-z_0-9]*)|(?P<param_name>\?)
? = 1
hero = 35
minimum = 71
maximum = 115
minimum_badge = 71
maximum_badge = 115
minimum_support = 20
member_count = 200
sample_size = 100
freshness = 120
ownership_before_seconds = 1200
version = 1
value = 1
partition = 'discovery'
match_mode = 'Ranked'
game_mode = 'Normal'
since = '2026-01-01T00:00:00Z'
as_of = '2026-01-02T00:00:00Z'
discovery_end = 1
train_end = 2
validation_end = 3
directory = '/tmp/sqlfluff'
metadata_path = '/tmp/sqlfluff/metadata.duckdb'
table = 'source_table'
path = '/tmp/sqlfluff/output.parquet'
